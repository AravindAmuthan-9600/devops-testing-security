{
  "info": {
    "name": "DevOps Security API Tests",
    "_postman_id": "devops-security-api-tests",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health API",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:5000/api/health",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["api", "health"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Application status is UP\", function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData.status).to.eql(\"UP\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Add API",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:5000/api/add?a=10&b=20",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["api", "add"],
          "query": [
            {
              "key": "a",
              "value": "10"
            },
            {
              "key": "b",
              "value": "20"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Addition result is 30\", function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData.result).to.eql(30);",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
